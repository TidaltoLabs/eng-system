{
  "$schema": "https://antigravity.google/schemas/v1/plugin.json",
  "name": "eng-system",
  "displayName": "Engineering System",
  "version": "0.3.4",
  "description": "工程文档体系技能组：总入口路由、骨架引导、调研协议、决策记录、架构规格、里程碑规划与验收、一致性审查。适用于任何需要长期维护文档的项目。",
  "logo": "logos/logo.svg",
  "suggestedPrompts": [
